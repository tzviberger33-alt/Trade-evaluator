<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guillotine League Trade Evaluator</title>
<style>
  :root {
    --bg: #0f172a;
    --card: #1e293b;
    --border: #334155;
    --text: #f8fafc;
    --muted: #94a3b8;
    --accent: #3b82f6;
    --green: #22c55e;
    --yellow: #eab308;
    --red: #ef4444;
  }
  * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  body { background: var(--bg); color: var(--text); margin: 0; padding: 24px; }
  .container { max-width: 960px; margin: 0 auto; }
  h1, h2, h3 { margin-top: 0; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
  @media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
  .player-row { display: flex; gap: 8px; margin-bottom: 8px; }
  input, select, button { background: #0b1120; border: 1px solid var(--border); color: var(--text); padding: 8px 12px; border-radius: 6px; font-size: 14px; }
  input:focus, select:focus { outline: none; border-color: var(--accent); }
  input[type="text"] { flex: 2; }
  input[type="number"] { width: 90px; }
  button { cursor: pointer; background: var(--accent); border: none; font-weight: 600; }
  button:hover { opacity: 0.9; }
  button.secondary { background: var(--border); }
  button.danger { background: #7f1d1d; color: #fca5a5; }
  .meta-inputs { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }
  .total-badge { font-size: 15px; font-weight: 600; color: var(--muted); margin-top: 12px; }
  .total-badge span { color: var(--text); font-size: 18px; }
  .verdict-box { background: var(--card); border: 2px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 24px; text-align: center; }
  .verdict-title { font-size: 22px; font-weight: bold; margin-bottom: 8px; }
  .verdict-desc { color: var(--muted); font-size: 15px; }
  table { width: 100%; border-collapse: collapse; margin-top: 12px; }
  th, td { text-align: left; padding: 10px; border-bottom: 1px solid var(--border); font-size: 14px; }
  th { color: var(--muted); font-weight: 600; }
  .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
  .badge-green { background: #14532d; color: #86efac; }
  .badge-yellow { background: #713f12; color: #fde047; }
  .badge-red { background: #7f1d1d; color: #fca5a5; }
</style>
</head>
<body>

<div class="container">
  <h1>Guillotine Trade Evaluator & Ledger</h1>
  <p style="color: var(--muted); margin-bottom: 20px;">200 FAAB baseline with Survival & Brink Premium logic.</p>

  <div class="grid">
    <!-- Side A -->
    <div class="card">
      <h3>Team A Assets</h3>
      <div id="sideAPlayers"></div>
      <button type="button" class="secondary" onclick="addPlayerRow('A')">+ Add Player</button>
      <div class="meta-inputs">
        <label>Team A FAAB Included:
          <input type="number" id="teamA_faab" min="0" max="200" value="0" oninput="calculate()">
        </label>
        <div class="total-badge">Team A Package Value: <span id="teamA_total">0</span> FAAB</div>
      </div>
    </div>

    <!-- Side B -->
    <div class="card">
      <h3>Team B Assets</h3>
      <div id="sideBPlayers"></div>
      <button type="button" class="secondary" onclick="addPlayerRow('B')">+ Add Player</button>
      <div class="meta-inputs">
        <label>Team B FAAB Included:
          <input type="number" id="teamB_faab" min="0" max="200" value="0" oninput="calculate()">
        </label>
        <div class="total-badge">Team B Package Value: <span id="teamB_total">0</span> FAAB</div>
      </div>
    </div>
  </div>

  <!-- Settings & Verdict -->
  <div class="card" style="margin-bottom: 20px;">
    <label style="cursor: pointer; display: flex; align-items: center; gap: 10px; font-weight: 600;">
      <input type="checkbox" id="brinkCheck" onchange="calculate()">
      Is either team on the Brink of elimination this week? (Survival Mode)
    </label>
  </div>

  <div class="verdict-box" id="verdictBox">
    <div class="verdict-title" id="verdictTitle">Enter Players to Analyze</div>
    <div class="verdict-desc" id="verdictDesc">Values are calibrated to a 200 FAAB Guillotine economy.</div>
    <div style="margin-top: 16px;">
      <button type="button" onclick="logCurrentTrade()">Log Trade to History</button>
    </div>
  </div>

  <!-- History Ledger -->
  <div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <h3>League Transaction History</h3>
      <button class="secondary" style="font-size: 12px;" onclick="clearHistory()">Clear History</button>
    </div>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Side A Sends</th>
          <th>Side B Sends</th>
          <th>Net Diff</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="historyBody"></tbody>
    </table>
  </div>
</div>

<datalist id="playerList"></datalist>

<script>
const playerValuations = {
  "Christian McCaffrey": 145, "CeeDee Lamb": 140, "Justin Jefferson": 140, "Ja'Marr Chase": 135,
  "Bijan Robinson": 130, "Breece Hall": 125, "Amon-Ra St. Brown": 125, "Saquon Barkley": 120,
  "Jahmyr Gibbs": 110, "Josh Allen": 100, "Lamar Jackson": 95, "Tyreek Hill": 90,
  "Nico Collins": 90, "Marvin Harrison Jr.": 85, "Derrick Henry": 85, "Garrett Wilson": 80,
  "Kyren Williams": 80, "Travis Kelce": 75, "Puka Nacua": 75, "Drake London": 70,
  "Kenneth Walker III": 65, "Jayden Daniels": 65, "Sam LaPorta": 60, "Trey McBride": 60,
  "DeVonta Smith": 55, "DK Metcalf": 55, "Zay Flowers": 50, "Chuba Hubbard": 40,
  "Jerome Ford": 35, "Rico Dowdle": 25, "Khalil Shakir": 20, "Tyler Allgeier": 15,
  "Braelon Allen": 15, "Ray Davis": 10
};

// Populate datalist
const datalist = document.getElementById('playerList');
for (const p in playerValuations) {
  const opt = document.createElement('option');
  opt.value = p;
  datalist.appendChild(opt);
}

function addPlayerRow(side, name = '', val = '') {
  const container = document.getElementById(`side${side}Players`);
  const div = document.createElement('div');
  div.className = 'player-row';
  div.innerHTML = `
    <input type="text" list="playerList" placeholder="Player Name" value="${name}" oninput="onPlayerNameInput(this, '${side}')">
    <input type="number" placeholder="Val" value="${val}" min="0" max="200" oninput="calculate()">
    <button type="button" class="danger" onclick="this.parentElement.remove(); calculate();">×</button>
  `;
  container.appendChild(div);
  calculate();
}

function onPlayerNameInput(input, side) {
  const valInput = input.parentElement.querySelector('input[type="number"]');
  if (playerValuations[input.value]) {
    valInput.value = playerValuations[input.value];
  }
  calculate();
}

function getSideTotal(side) {
  const rows = document.querySelectorAll(`#side${side}Players .player-row`);
  let total = 0;
  rows.forEach(r => {
    total += Number(r.querySelector('input[type="number"]').value) || 0;
  });
  total += Number(document.getElementById(`team${side}_faab`).value) || 0;
  return total;
}

let currentEvaluation = null;

function calculate() {
  const totalA = getSideTotal('A');
  const totalB = getSideTotal('B');
  document.getElementById('teamA_total').textContent = totalA;
  document.getElementById('teamB_total').textContent = totalB;

  const diff = Math.abs(totalA - totalB);
  const isBrink = document.getElementById('brinkCheck').checked;
  const vBox = document.getElementById('verdictBox');
  const vTitle = document.getElementById('verdictTitle');
  const vDesc = document.getElementById('verdictDesc');

  if (totalA === 0 && totalB === 0) {
    vTitle.textContent = "Enter Players to Analyze";
    vTitle.style.color = "var(--text)";
    vDesc.textContent = "Values are calibrated to a 200 FAAB Guillotine economy.";
    currentEvaluation = null;
    return;
  }

  let status = "";
  let badgeClass = "";

  if (diff <= 20) {
    status = "Approved — Fair Market Trade";
    badgeClass = "badge-green";
    vTitle.style.color = "var(--green)";
    vDesc.textContent = `Point difference is ${diff} FAAB (within the ±20 standard tolerance).`;
  } else if (diff <= 60 && isBrink) {
    status = "Approved — Brink Survival Premium";
    badgeClass = "badge-yellow";
    vTitle.style.color = "var(--yellow)";
    vDesc.textContent = `Point difference is ${diff} FAAB. Validated as an emergency survival move.`;
  } else if (diff <= 60 && !isBrink) {
    status = "Review Recommended — Disparity Without Elimination Risk";
    badgeClass = "badge-yellow";
    vTitle.style.color = "var(--yellow)";
    vDesc.textContent = `Point difference is ${diff} FAAB. Without elimination risk, this trade is noticeably lopsided.`;
  } else {
    status = "Flagged for Veto — Severe Value Disparity";
    badgeClass = "badge-red";
    vTitle.style.color = "var(--red)";
    vDesc.textContent = `Point difference is ${diff} FAAB. Exceeds survival thresholds; potential collusion or fire sale.`;
  }

  vTitle.textContent = status;
  currentEvaluation = { totalA, totalB, diff, status, badgeClass };
}

function getPackageSummary(side) {
  const rows = document.querySelectorAll(`#side${side}Players .player-row`);
  const names = [];
  rows.forEach(r => {
    const n = r.querySelector('input[type="text"]').value;
    const v = r.querySelector('input[type="number"]').value;
    if (n) names.push(`${n} (${v})`);
  });
  const faab = Number(document.getElementById(`team${side}_faab`).value);
  if (faab > 0) names.push(`$${faab} FAAB`);
  return names.length ? names.join(', ') : 'None';
}

function logCurrentTrade() {
  if (!currentEvaluation) return;
  const history = JSON.parse(localStorage.getItem('guillotine_history') || '[]');
  const trade = {
    id: Date.now(),
    date: new Date().toLocaleDateString(),
    sideA: getPackageSummary('A'),
    sideB: getPackageSummary('B'),
    diff: currentEvaluation.diff,
    status: currentEvaluation.status,
    badgeClass: currentEvaluation.badgeClass
  };
  history.unshift(trade);
  localStorage.setItem('guillotine_history', JSON.stringify(history));
  renderHistory();
}

function deleteTrade(id) {
  let history = JSON.parse(localStorage.getItem('guillotine_history') || '[]');
  history = history.filter(t => t.id !== id);
  localStorage.setItem('guillotine_history', JSON.stringify(history));
  renderHistory();
}

function clearHistory() {
  if (confirm("Clear all logged transactions?")) {
    localStorage.removeItem('guillotine_history');
    renderHistory();
  }
}

function renderHistory() {
  const history = JSON.parse(localStorage.getItem('guillotine_history') || '[]');
  const tbody = document.getElementById('historyBody');
  tbody.innerHTML = '';
  if (history.length === 0) {
    tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color: var(--muted);">No past trades logged yet.</td></tr>`;
    return;
  }
  history.forEach(t => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${t.date}</td>
      <td>${t.sideA}</td>
      <td>${t.sideB}</td>
      <td>${t.diff} FAAB</td>
      <td><span class="badge ${t.badgeClass}">${t.status.split('—')[0]}</span></td>
      <td><button class="danger" style="padding: 4px 8px; font-size: 11px;" onclick="deleteTrade(${t.id})">Delete</button></td>
    `;
    tbody.appendChild(tr);
  });
}

// Initial setup
addPlayerRow('A');
addPlayerRow('B');
renderHistory();
</script>
</body>
</html>
